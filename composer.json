{
    "name": "projectsend/community-modules",
    "description": "Community-exclusive feature modules for ProjectSend — private, never part of the hosted Cloud edition.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0",
        "inertiajs/inertia-laravel": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "ProjectSend\\CommunityModules\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ProjectSend\\CommunityModules\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ProjectSend\\CommunityModules\\CommunityModulesServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
